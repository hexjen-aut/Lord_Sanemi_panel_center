NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optionnel — connecte les stats live de WennaShop dans la section Projets
NEXT_PUBLIC_WENNA_SUPABASE_URL=https://your-wenna-project.supabase.co
NEXT_PUBLIC_WENNA_SUPABASE_ANON_KEY=your-wenna-anon-key

# Optionnel — active la recherche IA (web) dans la section Sorties.
# Clé secrète serveur uniquement : jamais de préfixe NEXT_PUBLIC_, jamais exposée au client.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optionnel — envoi d'email pour les rappels arrivés à échéance (route /api/cron/reminders,
# appelée par .github/workflows/reminders.yml toutes les 15 min). Secrets serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key
REMINDER_TO_EMAIL=you@example.com
CRON_SECRET=a-long-random-string
